{
  "expo": {
    "name": "Buckets",
    "slug": "buckets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Buckets_Logo_Icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Buckets_Logo_adaptive.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/Buckets_Logo_monochrome.png"
      },
      "package": "com.cubepad.buckets"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Buckets_Logo_adaptive.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#020625"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e73869e-f9ca-47b5-aa88-0dae2561260e"
      }
    }
  }
}
